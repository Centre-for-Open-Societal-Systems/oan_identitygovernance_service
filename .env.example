DATABASE_URL=postgresql+asyncpg://rbac:rbac@localhost:5432/central_rbac
KEYCLOAK_URL=https://keycloak.example.org

# Client `central-rbac` in realm master (confidential). One client, two uses:
#  - service account for admin API calls
#  - operator login: this backend runs the authorization-code exchange with the secret
KEYCLOAK_ADMIN_REALM=master
KEYCLOAK_CLIENT_ID=central-rbac
KEYCLOAK_CLIENT_SECRET=
AUTH_REALM=master
AUTH_CLIENT_ID=central-rbac
# Redirect URI registered on the client: ${PUBLIC_URL}/auth/callback
PUBLIC_URL=https://rbac.example.org
POST_LOGIN_URL=https://rbac-ui.example.org/
COOKIE_SECURE=true
ALLOWED_ORIGINS=["https://rbac-ui.example.org"]

# Optional: accept the staff IAM access-token cookie too
IAM_ISSUER=
IAM_CLIENT_ID=
IAM_COOKIE_NAME=X-Access-Token
