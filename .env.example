# Settings use the RBAC_ prefix; names without it are the library's COMMON_ settings.
RBAC_DB_DATASOURCE=postgresql+asyncpg://rbac:rbac@localhost:5432/central_rbac
# or: RBAC_DB_HOSTNAME / RBAC_DB_PORT / RBAC_DB_USERNAME / RBAC_DB_PASSWORD / RBAC_DB_DBNAME
RBAC_KEYCLOAK_URL=https://keycloak.example.org

# Client `central-rbac` in realm staff (confidential). One client, two uses:
#  - service account for admin API calls
#  - operator login: this backend runs the authorization-code exchange with the secret
RBAC_KEYCLOAK_ADMIN_REALM=staff
RBAC_KEYCLOAK_CLIENT_ID=central-rbac
RBAC_KEYCLOAK_CLIENT_SECRET=
RBAC_AUTH_REALM=staff
RBAC_AUTH_CLIENT_ID=central-rbac
# Redirect URI registered on the client: ${RBAC_PUBLIC_URL}/auth/callback
RBAC_PUBLIC_URL=https://rbac.example.org
RBAC_POST_LOGIN_URL=https://rbac-ui.example.org/
RBAC_COOKIE_SECURE=true
RBAC_CORS_ALLOW_ORIGINS=["https://rbac-ui.example.org"]

# Optional: accept the staff IAM access-token cookie too
RBAC_IAM_ISSUER=
RBAC_IAM_CLIENT_ID=
RBAC_IAM_COOKIE_NAME=X-Access-Token
