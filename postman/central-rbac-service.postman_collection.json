    {
      "name": "2. Managed service: grievance, through RBAC",
      "item": [
        {
          "name": "Register oan-client with grievance's admin API",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{rbac_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{rbac_base_url}}/applications/create",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"realm\": \"{{kc_realm}}\",\n  \"mnemonic\": \"oan-client\",\n  \"admin_api_url\": \"{{grievance_admin_url}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "const j = pm.response.json();",
                  "pm.test('envelope ok', () => pm.expect(j.response_header.status).to.eql('SUCCESS'));",
                  "pm.environment.set('g_app_id', j.response_body.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Roles of oan-client include Grievance Officer",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{rbac_token}}"
              }
            ],
            "url": "{{rbac_base_url}}/applications/{{g_app_id}}/roles/list"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
