{
  "info": {
    "name": "central-rbac service (own routes)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Start the service with the central-rbac client of the staff realm (login and service account), then run 0 Setup -> 1 Service routes -> 2 Cleanup. Needs kc_base_url, kc_realm, rbac_client_secret, op_username, op_password."
  },
  "item": [
    {
      "name": "0. Setup: operator token",
      "item": [
        {
          "name": "Operator token (direct login in the staff realm)",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{kc_base_url}}/realms/{{kc_realm}}/protocol/openid-connect/token",
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "grant_type",
                  "value": "password"
                },
                {
                  "key": "client_id",
                  "value": "central-rbac"
                },
                {
                  "key": "client_secret",
                  "value": "{{rbac_client_secret}}"
                },
                {
                  "key": "username",
                  "value": "{{op_username}}"
                },
                {
                  "key": "password",
                  "value": "{{op_password}}"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "pm.environment.set('rbac_token', pm.response.json().access_token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Service account token (client credentials)",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{kc_base_url}}/realms/{{kc_realm}}/protocol/openid-connect/token",
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "grant_type",
                  "value": "client_credentials"
                },
                {
                  "key": "client_id",
                  "value": "central-rbac"
                },
                {
                  "key": "client_secret",
                  "value": "{{rbac_client_secret}}"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "pm.environment.set('kc_token', pm.response.json().access_token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Find the operator",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{kc_token}}"
              }
            ],
            "url": "{{kc_base_url}}/admin/realms/{{kc_realm}}/users?username={{op_username}}&exact=true"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "pm.environment.set('rbac_op_id', pm.response.json()[0].id);"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "1. Service routes",
      "item": [
        {
          "name": "Ping",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{rbac_base_url}}/ping"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Unauthenticated is rejected",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{rbac_base_url}}/realms/list"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 401', () => pm.response.to.have.status(401));",
                  "const j = pm.response.json();",
                  "pm.test('error AUTH_REQUIRED', () => pm.expect(j.response_header.error_code).to.eql('AUTH_REQUIRED'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Who am I",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{rbac_token}}"
              }
            ],
            "url": "{{rbac_base_url}}/auth/me"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "const j = pm.response.json();",
                  "pm.test('envelope ok', () => pm.expect(j.response_header.status).to.eql('SUCCESS'));",
                  "pm.test('has rbac-admin', () => pm.expect(JSON.stringify(j.response_body)).to.include('rbac-admin'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Register realm",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{rbac_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{rbac_base_url}}/realms/register",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"{{kc_realm}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "const j = pm.response.json();",
                  "pm.test('envelope ok', () => pm.expect(j.response_header.status).to.eql('SUCCESS'));"
                ]
              }
            }
          ]
        },
        {
          "name": "List realms",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{rbac_token}}"
              }
            ],
            "url": "{{rbac_base_url}}/realms/list"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "const j = pm.response.json();",
                  "pm.test('envelope ok', () => pm.expect(j.response_header.status).to.eql('SUCCESS'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Create application",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{rbac_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{rbac_base_url}}/applications/create",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"realm\": \"{{kc_realm}}\",\n  \"mnemonic\": \"newman-app\",\n  \"description\": \"Created by the newman run\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "const j = pm.response.json();",
                  "pm.test('envelope ok', () => pm.expect(j.response_header.status).to.eql('SUCCESS'));",
                  "pm.environment.set('app_id', j.response_body.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Operator was granted OAN Administrator on the new client",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{kc_token}}"
              }
            ],
            "url": "{{kc_base_url}}/admin/realms/{{kc_realm}}/users/{{rbac_op_id}}/role-mappings"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "const m = pm.response.json().clientMappings || {};",
                  "pm.test('OAN Administrator under newman-app', () => pm.expect(JSON.stringify((m['newman-app']||{}).mappings||[])).to.include('OAN Administrator'));"
                ]
              }
            }
          ]
        },
        {
          "name": "First sync imported the role",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{rbac_token}}"
              }
            ],
            "url": "{{rbac_base_url}}/roles/list?application_id={{app_id}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "const j = pm.response.json();",
                  "pm.test('envelope ok', () => pm.expect(j.response_header.status).to.eql('SUCCESS'));",
                  "const r = j.response_body.find(x => x.name === 'OAN Administrator');",
                  "pm.test('imported', () => pm.expect(r && r.status).to.eql('imported'));",
                  "pm.environment.set('rbac_role_id', r && r.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "List applications",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{rbac_token}}"
              }
            ],
            "url": "{{rbac_base_url}}/applications/list?realm={{kc_realm}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "const j = pm.response.json();",
                  "pm.test('envelope ok', () => pm.expect(j.response_header.status).to.eql('SUCCESS'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Set allow-list",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{rbac_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{rbac_base_url}}/applications/{{app_id}}/allow-list",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"permissions\": [\n    {\n      \"resource\": \"Farmer\",\n      \"action\": \"read\"\n    }\n  ]\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "const j = pm.response.json();",
                  "pm.test('envelope ok', () => pm.expect(j.response_header.status).to.eql('SUCCESS'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Create role without admin API is recorded as failed",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{rbac_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{rbac_base_url}}/roles/create",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"application_id\": \"{{app_id}}\",\n  \"name\": \"newman-role\",\n  \"description\": \"x\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "const j = pm.response.json();",
                  "pm.test('role failed, no admin_api_url', () => { pm.expect(j.response_body.status).to.eql('failed'); pm.expect(j.response_body.error).to.include('admin_api_url'); });"
                ]
              }
            }
          ]
        },
        {
          "name": "List roles",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{rbac_token}}"
              }
            ],
            "url": "{{rbac_base_url}}/roles/list?application_id={{app_id}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "const j = pm.response.json();",
                  "pm.test('envelope ok', () => pm.expect(j.response_header.status).to.eql('SUCCESS'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Create user",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{rbac_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{rbac_base_url}}/users/create",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"realm\": \"{{kc_realm}}\",\n  \"username\": \"newman.user\",\n  \"email\": \"newman.user@example.com\",\n  \"first_name\": \"Newman\",\n  \"last_name\": \"User\",\n  \"send_invite\": false,\n  \"role_ids\": [\n    \"{{rbac_role_id}}\"\n  ]\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "const j = pm.response.json();",
                  "pm.test('envelope ok', () => pm.expect(j.response_header.status).to.eql('SUCCESS'));",
                  "pm.environment.set('user_id', j.response_body.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "List users",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{rbac_token}}"
              }
            ],
            "url": "{{rbac_base_url}}/users/list?realm={{kc_realm}}&search=newman"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "const j = pm.response.json();",
                  "pm.test('envelope ok', () => pm.expect(j.response_header.status).to.eql('SUCCESS'));",
                  "pm.test('user listed', () => pm.expect(JSON.stringify(j.response_body)).to.include('newman.user'));"
                ]
              }
            }
          ]
        },
        {
          "name": "User roles",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{rbac_token}}"
              }
            ],
            "url": "{{rbac_base_url}}/users/{{user_id}}/roles?realm={{kc_realm}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "const j = pm.response.json();",
                  "pm.test('envelope ok', () => pm.expect(j.response_header.status).to.eql('SUCCESS'));",
                  "pm.test('has the role', () => pm.expect(JSON.stringify(j.response_body)).to.include('OAN Administrator'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Disable user",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{rbac_token}}"
              }
            ],
            "url": "{{rbac_base_url}}/users/{{user_id}}/disable?realm={{kc_realm}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "const j = pm.response.json();",
                  "pm.test('envelope ok', () => pm.expect(j.response_header.status).to.eql('SUCCESS'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Enable user",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{rbac_token}}"
              }
            ],
            "url": "{{rbac_base_url}}/users/{{user_id}}/enable?realm={{kc_realm}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "const j = pm.response.json();",
                  "pm.test('envelope ok', () => pm.expect(j.response_header.status).to.eql('SUCCESS'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Sync status",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{rbac_token}}"
              }
            ],
            "url": "{{rbac_base_url}}/sync/status?realm={{kc_realm}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "const j = pm.response.json();",
                  "pm.test('envelope ok', () => pm.expect(j.response_header.status).to.eql('SUCCESS'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Disable application",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{rbac_token}}"
              }
            ],
            "url": "{{rbac_base_url}}/applications/{{app_id}}/disable"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "const j = pm.response.json();",
                  "pm.test('envelope ok', () => pm.expect(j.response_header.status).to.eql('SUCCESS'));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "2. Cleanup: remove the application client and test user",
      "item": [
        {
          "name": "Service account token (client credentials)",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{kc_base_url}}/realms/{{kc_realm}}/protocol/openid-connect/token",
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "grant_type",
                  "value": "client_credentials"
                },
                {
                  "key": "client_id",
                  "value": "central-rbac"
                },
                {
                  "key": "client_secret",
                  "value": "{{rbac_client_secret}}"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "pm.environment.set('kc_token', pm.response.json().access_token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Find the application's Keycloak client",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{kc_token}}"
              }
            ],
            "url": "{{kc_base_url}}/admin/realms/{{kc_realm}}/clients?clientId=newman-app"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "const a=pm.response.json(); pm.environment.set('app_client_uuid', a.length?a[0].id:'');"
                ]
              }
            }
          ]
        },
        {
          "name": "Delete the application's Keycloak client",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{kc_token}}"
              }
            ],
            "url": "{{kc_base_url}}/admin/realms/{{kc_realm}}/clients/{{app_client_uuid}}"
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if(!pm.environment.get('app_client_uuid')) pm.execution.skipRequest();"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('deleted or absent', () => pm.expect([204,404]).to.include(pm.response.code));"
                ]
              }
            }
          ]
        },
        {
          "name": "Find the test user",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{kc_token}}"
              }
            ],
            "url": "{{kc_base_url}}/admin/realms/{{kc_realm}}/users?username=newman.user&exact=true"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "const a=pm.response.json(); pm.environment.set('user_id', a.length?a[0].id:'');"
                ]
              }
            }
          ]
        },
        {
          "name": "Delete the test user",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{kc_token}}"
              }
            ],
            "url": "{{kc_base_url}}/admin/realms/{{kc_realm}}/users/{{user_id}}"
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if(!pm.environment.get('user_id')) pm.execution.skipRequest();"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('deleted', () => pm.expect([204,404]).to.include(pm.response.code));"
                ]
              }
            }
          ]
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "rbac_base_url",
      "value": "http://localhost:8000"
    }
  ]
}