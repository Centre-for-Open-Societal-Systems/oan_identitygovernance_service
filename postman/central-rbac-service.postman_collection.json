{
  "info": {
    "name": "central-rbac service (own routes)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Start the service with the central-rbac client of the staff realm (login and service account), then run 0 Setup -> 1 Service routes -> 2 Cleanup. Needs kc_base_url, kc_realm, rbac_client_secret, op_username, op_password."
  },
  "item": [
    {
      "name": "0. Setup: operator token",
      "item": [
        {
          "name": "Operator token (direct login in the staff realm)",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{kc_base_url}}/realms/{{kc_realm}}/protocol/openid-connect/token",
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "grant_type",
                  "value": "password"
                },
                {
                  "key": "client_id",
                  "value": "central-rbac"
                },
                {
                  "key": "client_secret",
                  "value": "{{rbac_client_secret}}"
                },
                {
                  "key": "username",
                  "value": "{{op_username}}"
                },
                {
                  "key": "password",
                  "value": "{{op_password}}"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "pm.environment.set('rbac_token', pm.response.json().access_token);"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "1. Service routes",
      "item": [
        {
          "name": "Ping",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{rbac_base_url}}/ping"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Unauthenticated is rejected",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{rbac_base_url}}/realms/list"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 401', () => pm.response.to.have.status(401));",
                  "const j = pm.response.json();",
                  "pm.test('error AUTH_REQUIRED', () => pm.expect(j.response_header.error_code).to.eql('AUTH_REQUIRED'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Who am I",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{rbac_token}}"
              }
            ],
            "url": "{{rbac_base_url}}/auth/me"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "const j = pm.response.json();",
                  "pm.test('envelope ok', () => pm.expect(j.response_header.status).to.eql('SUCCESS'));",
                  "pm.test('has rbac-admin', () => pm.expect(JSON.stringify(j.response_body)).to.include('rbac-admin'));",
                  "pm.environment.set('rbac_op_id', j.response_body.sub);"
                ]
              }
            }
          ]
        },
        {
          "name": "Register realm",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{rbac_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{rbac_base_url}}/realms/register",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"{{kc_realm}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "const j = pm.response.json();",
                  "pm.test('envelope ok', () => pm.expect(j.response_header.status).to.eql('SUCCESS'));"
                ]
              }
            }
          ]
        },
