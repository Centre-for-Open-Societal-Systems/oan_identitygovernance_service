          "name": "Set the role's permissions in grievance",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{rbac_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{rbac_base_url}}/applications/{{g_app_id}}/roles/Grievance%20RBAC%20Test/permissions",
            "body": {
