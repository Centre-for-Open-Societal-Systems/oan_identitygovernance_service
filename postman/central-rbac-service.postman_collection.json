                  "pm.test('Grievance Officer listed', () => pm.expect(j.response_body.map(x => x.name)).to.include('Grievance Officer'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Set allow-list",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{rbac_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{rbac_base_url}}/applications/{{g_app_id}}/allow-list",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"permissions\": [\n    {\n      \"resource\": \"Grievance\",\n      \"action\": \"read\"\n    },\n    {\n      \"resource\": \"Grievance\",\n      \"action\": \"write\"\n    }\n  ]\n}"
            }
          },
          "event": [
            {
              "listen": "test",
