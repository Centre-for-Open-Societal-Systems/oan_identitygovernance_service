          "name": "Create role in grievance (and its Keycloak client role)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{rbac_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{rbac_base_url}}/applications/{{g_app_id}}/roles/create",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Grievance RBAC Test\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "const j = pm.response.json();",
                  "pm.test('envelope ok', () => pm.expect(j.response_header.status).to.eql('SUCCESS'));",
                  "pm.test('created', () => pm.expect(j.response_body.name).to.eql('Grievance RBAC Test'));"
                ]
              }
            }
          ]
        },
        {
          "name": "The new role is listed from Keycloak",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{rbac_token}}"
              }
            ],
            "url": "{{rbac_base_url}}/applications/{{g_app_id}}/roles/list"
          },
          "event": [
